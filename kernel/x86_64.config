# x86_64 fragment: the x86-specific required options of SPEC §4.2 plus the platform plumbing the
# QEMU q35 machine and the N100 box need. Merged over allnoconfig after required.config.
# Deferred to M5 (metal boot and installer): framebuffer console, USB and HID, NVMe/AHCI/eMMC,
# cpufreq.

# Architecture and platform
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_PCIEPORTBUS=y
CONFIG_ACPI=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_CPU_IDLE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_JUMP_LABEL=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_X86_KERNEL_IBT=y
# Machine-check handling: a hardware error becomes a logged panic (pstore) rather than a silent reset.
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_CPU_MITIGATIONS=y
# Every x86 mitigation that defaults to y upstream; allnoconfig would turn them all off.
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SRBDS=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_ITS=y
CONFIG_MITIGATION_TSA=y
# MITIGATION_VMSCAPE protects a KVM host from its guests and depends on KVM, which we do not build.
CONFIG_LEGACY_VSYSCALL_NONE=y

# Console
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Firmware interfaces
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_RTC_DRV_CMOS=y

# Watchdogs: N100 (iTCO) and QEMU (i6300esb)
CONFIG_ITCO_WDT=y
CONFIG_I6300ESB_WDT=y

# NICs: Intel igc/igb/e1000e, Realtek r8169 (selects FW_LOADER; no firmware files are shipped), virtio
CONFIG_NET_VENDOR_INTEL=y
CONFIG_IGC=y
CONFIG_IGB=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_VIRTIO_PCI=y
# CONFIG_VIRTIO_PCI_LEGACY is not set

# Telemetry
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y

# Compression of the kernel and the built-in initramfs
CONFIG_KERNEL_ZSTD=y
CONFIG_RD_ZSTD=y
CONFIG_INITRAMFS_COMPRESSION_ZSTD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set

# Identity
CONFIG_LOCALVERSION="-openfeo"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="openfeo"

# Not wanted
# CONFIG_IA32_EMULATION is not set
# CONFIG_SWAP is not set
