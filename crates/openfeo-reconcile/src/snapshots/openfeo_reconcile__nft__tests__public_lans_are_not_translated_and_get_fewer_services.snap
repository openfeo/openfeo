---
source: crates/openfeo-reconcile/src/nft.rs
expression: d
---
ruleset:
  - add:
      table:
        family: inet
        name: openfeo
  - delete:
      table:
        family: inet
        name: openfeo
  - add:
      table:
        family: inet
        name: openfeo
  - add:
      set:
        elem:
          - p0
        family: inet
        name: wan_if
        table: openfeo
        type: ifname
  - add:
      set:
        elem:
          - br-dmz
          - br-lan0
        family: inet
        name: lan_if
        table: openfeo
        type: ifname
  - add:
      set:
        elem:
          - br-lan0
        family: inet
        name: lan_priv_if
        table: openfeo
        type: ifname
  - add:
      set:
        family: inet
        name: lan_pub_dhcp_if
        table: openfeo
        type: ifname
  - add:
      set:
        elem:
          - br-dmz
          - br-lan0
        family: inet
        name: lan_to_wan
        table: openfeo
        type: ifname
  - add:
      set:
        elem:
          - concat:
              - br-dmz
              - br-dmz
          - concat:
              - br-lan0
              - br-lan0
        family: inet
        name: lan_same
        table: openfeo
        type:
          - ifname
          - ifname
  - add:
      set:
        elem:
          - concat:
              - br-dmz
              - br-dmz
          - concat:
              - br-lan0
              - br-lan0
        family: inet
        name: lan_pairs
        table: openfeo
        type:
          - ifname
          - ifname
  - add:
      set:
        elem:
          - prefix:
              addr: 192.168.1.0
              len: 24
        family: inet
        flags:
          - interval
        name: nat_nets
        table: openfeo
        type: ipv4_addr
  - add:
      map:
        elem:
          - - 2222
            - concat:
                - 192.168.1.2
                - 8080
        family: inet
        map:
          - ipv4_addr
          - inet_service
        name: fwd_tcp
        table: openfeo
        type: inet_service
  - add:
      map:
        family: inet
        map:
          - ipv4_addr
          - inet_service
        name: fwd_udp
        table: openfeo
        type: inet_service
  - add:
      map:
        elem:
          - - concat:
                - 192.0.2.249
                - 443
            - concat:
                - 192.168.1.2
                - 8080
        family: inet
        map:
          - ipv4_addr
          - inet_service
        name: fwd_pub_tcp
        table: openfeo
        type:
          - ipv4_addr
          - inet_service
  - add:
      map:
        family: inet
        map:
          - ipv4_addr
          - inet_service
        name: fwd_pub_udp
        table: openfeo
        type:
          - ipv4_addr
          - inet_service
  - add:
      set:
        elem:
          - concat:
              - p0
              - range:
                  - 192.0.2.234
                  - 192.0.2.238
              - 80
        family: inet
        flags:
          - interval
        name: rules_tcp
        table: openfeo
        type:
          - ifname
          - ipv4_addr
          - inet_service
  - add:
      set:
        family: inet
        flags:
          - interval
        name: rules_udp
        table: openfeo
        type:
          - ifname
          - ipv4_addr
          - inet_service
  - add:
      set:
        family: inet
        flags:
          - interval
        name: rules_other
        table: openfeo
        type:
          - ifname
          - ipv4_addr
          - inet_proto
  - add:
      set:
        family: inet
        flags:
          - interval
        name: rules_any
        table: openfeo
        type:
          - ifname
          - ipv4_addr
  - add:
      chain:
        family: inet
        hook: prerouting
        name: rpfilter
        policy: accept
        prio: -300
        table: openfeo
        type: filter
  - add:
      rule:
        chain: rpfilter
        expr:
          - match:
              left:
                concat:
                  - payload:
                      field: sport
                      protocol: udp
                  - payload:
                      field: dport
                      protocol: udp
              op: "=="
              right:
                set:
                  - concat:
                      - 67
                      - 68
                  - concat:
                      - 68
                      - 67
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: rpfilter
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@lan_if"
          - match:
              left:
                fib:
                  flags:
                    - saddr
                    - iif
                  result: oif
              op: "=="
              right: false
          - drop: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: rpfilter
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@wan_if"
          - match:
              left:
                fib:
                  flags:
                    - saddr
                  result: oif
              op: "=="
              right: false
          - drop: ~
        family: inet
        table: openfeo
  - add:
      chain:
        family: inet
        hook: input
        name: input
        policy: drop
        prio: 0
        table: openfeo
        type: filter
  - add:
      rule:
        chain: input
        expr:
          - match:
              left:
                ct:
                  key: state
              op: in
              right:
                - established
                - related
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: input
        expr:
          - match:
              left:
                ct:
                  key: state
              op: in
              right: invalid
          - drop: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: input
        expr:
          - match:
              left:
                meta:
                  key: iif
              op: "=="
              right: lo
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: input
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@lan_priv_if"
          - match:
              left:
                payload:
                  field: dport
                  protocol: udp
              op: "=="
              right:
                set:
                  - 53
                  - 67
                  - 123
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: input
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@lan_pub_dhcp_if"
          - match:
              left:
                payload:
                  field: dport
                  protocol: udp
              op: "=="
              right:
                set:
                  - 53
                  - 67
                  - 123
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: input
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@lan_priv_if"
          - match:
              left:
                payload:
                  field: dport
                  protocol: tcp
              op: "=="
              right:
                set:
                  - 53
                  - 80
                  - 443
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: input
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@lan_pub_dhcp_if"
          - match:
              left:
                payload:
                  field: dport
                  protocol: tcp
              op: "=="
              right: 53
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: input
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@lan_if"
          - match:
              left:
                meta:
                  key: l4proto
              op: "=="
              right:
                set:
                  - icmp
                  - icmpv6
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: input
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@wan_if"
          - match:
              left:
                payload:
                  field: sport
                  protocol: udp
              op: "=="
              right: 67
          - match:
              left:
                payload:
                  field: dport
                  protocol: udp
              op: "=="
              right: 68
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: input
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@wan_if"
          - match:
              left:
                payload:
                  field: type
                  protocol: icmp
              op: "=="
              right: echo-request
          - limit:
              burst: 100
              per: second
              rate: 50
          - accept: ~
        family: inet
        table: openfeo
  - add:
      chain:
        family: inet
        hook: forward
        name: forward
        policy: drop
        prio: 0
        table: openfeo
        type: filter
  - add:
      rule:
        chain: forward
        expr:
          - match:
              left:
                ct:
                  key: state
              op: in
              right:
                - established
                - related
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: forward
        expr:
          - match:
              left:
                ct:
                  key: state
              op: in
              right: invalid
          - drop: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: forward
        expr:
          - match:
              left:
                ct:
                  key: status
              op: in
              right: dnat
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@wan_if"
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: forward
        expr:
          - match:
              left:
                ct:
                  key: status
              op: in
              right: dnat
          - match:
              left:
                concat:
                  - meta:
                      key: iifname
                  - meta:
                      key: oifname
              op: "=="
              right: "@lan_pairs"
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: forward
        expr:
          - match:
              left:
                concat:
                  - meta:
                      key: iifname
                  - payload:
                      field: daddr
                      protocol: ip
                  - payload:
                      field: dport
                      protocol: tcp
              op: "=="
              right: "@rules_tcp"
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: forward
        expr:
          - match:
              left:
                concat:
                  - meta:
                      key: iifname
                  - payload:
                      field: daddr
                      protocol: ip
                  - payload:
                      field: dport
                      protocol: udp
              op: "=="
              right: "@rules_udp"
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: forward
        expr:
          - match:
              left:
                concat:
                  - meta:
                      key: iifname
                  - payload:
                      field: daddr
                      protocol: ip
                  - meta:
                      key: l4proto
              op: "=="
              right: "@rules_other"
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: forward
        expr:
          - match:
              left:
                concat:
                  - meta:
                      key: iifname
                  - payload:
                      field: daddr
                      protocol: ip
              op: "=="
              right: "@rules_any"
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: forward
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@lan_to_wan"
          - match:
              left:
                meta:
                  key: oifname
              op: "=="
              right: "@wan_if"
          - accept: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: forward
        expr:
          - match:
              left:
                concat:
                  - meta:
                      key: iifname
                  - meta:
                      key: oifname
              op: "=="
              right: "@lan_pairs"
          - accept: ~
        family: inet
        table: openfeo
  - add:
      chain:
        family: inet
        hook: prerouting
        name: dstnat
        policy: accept
        prio: -100
        table: openfeo
        type: nat
  - add:
      rule:
        chain: dstnat
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@wan_if"
          - match:
              left:
                fib:
                  flags:
                    - daddr
                  result: type
              op: "=="
              right: local
          - dnat:
              addr:
                map:
                  data: "@fwd_tcp"
                  key:
                    payload:
                      field: dport
                      protocol: tcp
              family: ip
              type_flags:
                - concat
        family: inet
        table: openfeo
  - add:
      rule:
        chain: dstnat
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@wan_if"
          - dnat:
              addr:
                map:
                  data: "@fwd_pub_tcp"
                  key:
                    concat:
                      - payload:
                          field: daddr
                          protocol: ip
                      - payload:
                          field: dport
                          protocol: tcp
              family: ip
              type_flags:
                - concat
        family: inet
        table: openfeo
  - add:
      rule:
        chain: dstnat
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@wan_if"
          - match:
              left:
                fib:
                  flags:
                    - daddr
                  result: type
              op: "=="
              right: local
          - dnat:
              addr:
                map:
                  data: "@fwd_udp"
                  key:
                    payload:
                      field: dport
                      protocol: udp
              family: ip
              type_flags:
                - concat
        family: inet
        table: openfeo
  - add:
      rule:
        chain: dstnat
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@wan_if"
          - dnat:
              addr:
                map:
                  data: "@fwd_pub_udp"
                  key:
                    concat:
                      - payload:
                          field: daddr
                          protocol: ip
                      - payload:
                          field: dport
                          protocol: udp
              family: ip
              type_flags:
                - concat
        family: inet
        table: openfeo
  - add:
      rule:
        chain: dstnat
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@lan_if"
          - match:
              left:
                fib:
                  flags:
                    - daddr
                  result: type
              op: "=="
              right: local
          - dnat:
              addr:
                map:
                  data: "@fwd_tcp"
                  key:
                    payload:
                      field: dport
                      protocol: tcp
              family: ip
              type_flags:
                - concat
        family: inet
        table: openfeo
  - add:
      rule:
        chain: dstnat
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@lan_if"
          - dnat:
              addr:
                map:
                  data: "@fwd_pub_tcp"
                  key:
                    concat:
                      - payload:
                          field: daddr
                          protocol: ip
                      - payload:
                          field: dport
                          protocol: tcp
              family: ip
              type_flags:
                - concat
        family: inet
        table: openfeo
  - add:
      rule:
        chain: dstnat
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@lan_if"
          - match:
              left:
                fib:
                  flags:
                    - daddr
                  result: type
              op: "=="
              right: local
          - dnat:
              addr:
                map:
                  data: "@fwd_udp"
                  key:
                    payload:
                      field: dport
                      protocol: udp
              family: ip
              type_flags:
                - concat
        family: inet
        table: openfeo
  - add:
      rule:
        chain: dstnat
        expr:
          - match:
              left:
                meta:
                  key: iifname
              op: "=="
              right: "@lan_if"
          - dnat:
              addr:
                map:
                  data: "@fwd_pub_udp"
                  key:
                    concat:
                      - payload:
                          field: daddr
                          protocol: ip
                      - payload:
                          field: dport
                          protocol: udp
              family: ip
              type_flags:
                - concat
        family: inet
        table: openfeo
  - add:
      chain:
        family: inet
        hook: postrouting
        name: srcnat
        policy: accept
        prio: 100
        table: openfeo
        type: nat
  - add:
      rule:
        chain: srcnat
        expr:
          - match:
              left:
                meta:
                  key: nfproto
              op: "=="
              right: ipv4
          - match:
              left:
                payload:
                  field: saddr
                  protocol: ip
              op: "=="
              right: "@nat_nets"
          - match:
              left:
                meta:
                  key: oifname
              op: "=="
              right: "@wan_if"
          - masquerade: ~
        family: inet
        table: openfeo
  - add:
      rule:
        chain: srcnat
        expr:
          - match:
              left:
                meta:
                  key: nfproto
              op: "=="
              right: ipv4
          - match:
              left:
                concat:
                  - meta:
                      key: iifname
                  - meta:
                      key: oifname
              op: "=="
              right: "@lan_same"
          - match:
              left:
                ct:
                  key: status
              op: in
              right: dnat
          - masquerade: ~
        family: inet
        table: openfeo
forwarding: true
wan_if:
  - p0
lan_if:
  - br-dmz
  - br-lan0
